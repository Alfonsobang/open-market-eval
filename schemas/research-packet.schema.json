{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alfonsobang/open-market-eval/schemas/research-packet.schema.json",
  "title": "A-Share Research Evidence Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "market", "query", "as_of", "evidence", "claims"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "packet_id": {"type": "string", "minLength": 1},
    "market": {"const": "cn_a_cash"},
    "query": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "publisher", "url", "published_at", "retrieved_at", "content_sha256", "is_primary"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
          "published_at": {"type": "string", "format": "date-time"},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "content_sha256": {"type": "string"},
          "is_primary": {"type": "boolean"}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
